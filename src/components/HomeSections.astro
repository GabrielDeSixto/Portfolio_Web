---
import AboutMe from "@/components/AboutMe.astro"
import AnimatedEntry from "@/components/AnimatedEntry.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Experience from "@/components/Experience.astro"
import Hero from "@/components/Hero.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import System from "@/components/icons/System.astro"
import TechWall from "@/components/TechWall.astro"
import Technologies from "@/components/Technologies.astro"
import BottomCTA from "@/components/BottomCTA.astro"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"
type tLang = (str: any) => any
const lang = getLangFromUrl(Astro.url)
const t: tLang = useTranslations(lang)

const headingClass =
  "flex items-center mb-6 text-3xl font-semibold tracking-tight gap-x-3 text-zinc-900 dark:text-zinc-50"
---

<main id="main-content" class="px-4">
  <SectionContainer class="pt-12 md:pt-24 pb-16 md:pb-28">
    <AnimatedEntry>
      <Hero />
    </AnimatedEntry>
  </SectionContainer>

  <TechWall />

  <div class="space-y-24 md:space-y-32">
    <SectionContainer id="experiencia">
      <AnimatedEntry>
        <h2 class={headingClass}>
          <Briefcase class="size-7" />
          {t('exp.title')}
        </h2>
        <Experience />
      </AnimatedEntry>
    </SectionContainer>

    <SectionContainer id="proyectos">
      <AnimatedEntry>
        <h2 class={headingClass}>
          <CodeIcon class="size-7" />
          {t('projects.title')}
        </h2>
        <Projects />
      </AnimatedEntry>
    </SectionContainer>

    <SectionContainer id="tecnologias">
      <AnimatedEntry>
        <h2 class={headingClass}>
          <System class="size-7" />
          {t('technologies.title')}
        </h2>
        <Technologies />
      </AnimatedEntry>
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <AnimatedEntry>
        <h2 class={headingClass}>
          <ProfileCheck class="size-7" />
          {t('about.title')}
        </h2>
        <AboutMe />
      </AnimatedEntry>
    </SectionContainer>
  </div>

  <BottomCTA />
</main>
