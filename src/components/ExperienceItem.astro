---
import LinkInline from "./LinkInline.astro"
interface Props {
  title: string
  company: string
  description: string
  link?: string
  linkLabel?: string
  date: string
}
const { title, company, description, link, linkLabel, date } = Astro.props
---

<article class="experience-item group">
  <div class="experience-header">
    <div class="experience-marker"></div>
    <div class="experience-meta">
      <h3 class="experience-title">{title}</h3>
      <h4 class="experience-company">{company}</h4>
      <time class="experience-date">{date}</time>
    </div>
  </div>
  
  <div class="experience-content">
    <p class="experience-description">{description}</p>
    {
      link && (
        <LinkInline href={link} class="experience-link">
          {linkLabel || "Saber más"}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      )
    }
  </div>
</article>

<style>
  .experience-item {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 0;
    border-left: 1px solid rgba(161, 161, 170, 0.2);
    margin-left: 1.5rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .experience-item:hover {
    transform: translateX(5px);
  }
  
  .experience-item:hover .experience-marker {
    background-color: #10b981; /* emerald-500 */
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
    transform: translateX(-50%) scale(1.2);
  }

  .experience-header {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .experience-marker {
    position: absolute;
    left: -0.5px;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    background: rgba(161, 161, 170, 0.5);
    transform: translateX(-50%);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .experience-meta {
    padding-left: 1.5rem;
  }

  .experience-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .experience-item:hover .experience-title {
    color: #10b981;
  }

  .experience-company {
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0.25rem 0;
    color: var(--color-text-primary);
  }

  .experience-date {
    display: inline-block;
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #10b981;
    margin-top: 0.25rem;
    padding: 0.2rem 0;
  }

  .experience-content {
    padding-left: 1.5rem;
    position: relative;
  }

  .experience-description {
    margin: 0;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .experience-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
    font-weight: 500;
    color: var(--color-text-primary);
    transition: color 0.2s ease;
  }

  .experience-link:hover {
    color: #10b981;
  }

  .experience-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: #10b981;
    transition: width 0.3s ease;
  }

  .experience-link:hover::after {
    width: 100%;
  }

  :root {
    --color-text-primary: #18181b;
    --color-text-secondary: #52525b;
  }

  :global(.dark) {
    --color-text-primary: #f4f4f5;
    --color-text-secondary: #a1a1aa;
  }

  @media (min-width: 768px) {
    .experience-item {
      flex-direction: row;
      gap: 2rem;
      padding: 2.5rem 0;
      border-left: none;
      margin-left: 0;
    }

    .experience-item:hover {
      transform: translateY(-2px) translateX(0);
    }

    .experience-header {
      flex: 0 0 30%;
      margin-bottom: 0;
    }

    .experience-marker {
      left: 30%;
    }

    .experience-meta {
      padding-left: 0;
    }

    .experience-content {
      flex: 1;
      padding-left: 2rem;
      border-left: 1px solid rgba(161, 161, 170, 0.2);
    }
    
    .experience-content::before {
      content: '';
      position: absolute;
      top: 0;
      left: -1px;
      width: 1px;
      height: 0;
      background: #10b981;
      transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .experience-item:hover .experience-content::before {
      height: 100%;
    }
  }
</style>
