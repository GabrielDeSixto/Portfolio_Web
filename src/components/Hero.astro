---
const personalImageAlt = "Gabriel De Sixto";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import Pdf from "@/components/icons/Pdf.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="max-w-2xl relative z-10">
  <div class="flex items-center gap-6 mb-8">
    <div class="relative group shrink-0">
      <div
        class="absolute -inset-0.5 bg-emerald-500/20 rounded-full blur opacity-0 group-hover:opacity-100 transition duration-500"
      >
      </div>
      <img
        class="relative rounded-full w-20 h-20 md:w-24 md:h-24 ring-1 ring-black/10 dark:ring-white/10 p-1 object-cover grayscale group-hover:grayscale-0 transition duration-500 bg-white dark:bg-[#121212] shrink-0"
        src="/me.jpg"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://github.com/GabrielDeSixto"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105 active:scale-95"
    >
      <Badge>{t("hero.badge")}</Badge>
    </a>
  </div>

  <h1
    class="text-5xl font-bold tracking-tighter text-zinc-900 sm:text-7xl dark:text-zinc-50 mb-6 leading-[1.1]"
  >
    {t("hero.title")}
  </h1>

  <div
    class="font-mono text-sm uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-400 mb-6 flex items-center gap-3"
  >
    <span class="w-8 h-[1px] bg-emerald-600/50 dark:bg-emerald-400/50"></span>
    System Online
  </div>

  <p
    class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-[55ch] [&>strong]:text-zinc-900 dark:[&>strong]:text-zinc-50 [&>strong]:font-medium"
    set:html={t("hero.bio")}
  />

  <nav class="flex flex-wrap gap-4 mt-10">
    <SocialPill
      href="mailto:gabrielsolanodesixto@gmail.com"
      class="bg-zinc-900 text-zinc-50 hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-900 dark:hover:bg-zinc-200"
    >
      <MailIcon class="size-4" />
      {t("hero.mail")}
    </SocialPill>
    <SocialPill
      href="https://www.linkedin.com/in/gabriel-solano-de-sixto/"
      class="bg-transparent border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 dark:hover:border-emerald-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
    >
      <LinkedInIcon class="size-4" />
      {t("hero.linkedin")}
    </SocialPill>
    <SocialPill
      href="https://drive.google.com/file/d/1BWtoyHttQKXC6WyUFp6MUeUtr57306yt/view?usp=sharing"
      class="bg-transparent border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 dark:hover:border-emerald-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
    >
      <Pdf class="size-4" />
      {t("hero.cv")}
    </SocialPill>
  </nav>
</div>
