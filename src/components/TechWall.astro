---
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const techs = [
  "TypeScript",
  "React",
  "Next.js",
  "Node.js",
  "NestJS",
  "Python",
  "FastAPI",
  "PostgreSQL",
  "MongoDB",
  "Google Cloud",
  "Rundeck",
  "Tailwind CSS",
]
---

<section class="w-full py-8 md:py-10 border-y border-zinc-200/70 dark:border-zinc-800/70 mb-16 md:mb-24">
  <p class="text-center text-xs font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400 mb-6">
    {t('stack.title')}
  </p>
  <div class="marquee">
    <ul class="marquee-track" aria-label={t('stack.title')}>
      {techs.map((tech) => (
        <li class="font-mono text-sm text-zinc-600 dark:text-zinc-400">{tech}</li>
      ))}
    </ul>
    <ul class="marquee-track" aria-hidden="true">
      {techs.map((tech) => (
        <li class="font-mono text-sm text-zinc-600 dark:text-zinc-400">{tech}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee {
    display: flex;
    gap: 2.5rem;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    gap: 2.5rem;
    padding-right: 2.5rem;
    animation: marquee-scroll 45s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }

    .marquee-track {
      animation: none;
    }
  }
</style>
