---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Node from "./icons/Node.astro"
import Python from "./icons/Python.astro"
import Code from "./icons/Code.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"
type tLang = (str: any) => any;
const lang = getLangFromUrl(Astro.url)
const t:tLang = useTranslations(lang);
type TagType = {
  name: string;
  icon: (_props: Record<string, any>) => any;
};
type TagsType = {
  [key: string]: TagType;
};
const TAGS: TagsType = {
  nextjs: { name: 'Next.js', icon: NextJS },
  tailwindcss: { name: 'Tailwind CSS', icon: Tailwind },
  nodejs: { name: 'Node.js', icon: Node },
  nestjs: { name: 'NestJS', icon: Code },
  python: { name: 'Python', icon: Python },
  opencv: { name: 'OpenCV', icon: Code },
  n8n: { name: 'n8n', icon: Code },
  typescript: { name: 'TypeScript', icon: Code },
};
interface ProjectType {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  github?: string;
}
const PROJECTS:ProjectType[] = t('projects');
---

<ol class="mt-8 divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
  {
    PROJECTS.map(({ title, description, tags, link, github }, index) => (
      <li class="project-row group relative grid gap-x-8 gap-y-4 py-8 md:grid-cols-[auto_1fr_auto] md:items-start">
        <span class="font-mono text-sm tabular-nums text-zinc-400 dark:text-zinc-600 md:pt-1">
          {String(index + 1).padStart(2, '0')}
        </span>

        <div class="max-w-[65ch]">
          <h3 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
            {title}
          </h3>
          <p class="mt-2 text-pretty leading-relaxed text-zinc-600 dark:text-zinc-400">
            {description}
          </p>
          <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
            {tags.map((item) => {
              const tag:TagType = TAGS[item];
              if (!tag) return null;
              return (
                <li class="flex items-center gap-x-1.5 font-mono text-xs text-zinc-500 dark:text-zinc-400">
                  <tag.icon class="size-3.5" />{tag.name}
                </li>
              )
            })}
          </ul>
        </div>

        <footer class="flex flex-wrap items-center gap-3 md:justify-end md:pt-1">
          {github && (
            <LinkButton href={github} class="gap-2">
              <GitHub class="size-4" />
              <span>{t('projects.code')}</span>
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link} class="gap-2">
              <Link class="size-4" />
              <span>{t('projects.demo')}</span>
            </LinkButton>
          )}
        </footer>
      </li>
    ))
  }
</ol>

<style>
  .project-row::before {
    content: "";
    position: absolute;
    inset: 0 -1.5rem;
    border-radius: 1rem;
    background: rgb(16 185 129 / 0.06);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .project-row:hover::before,
  .project-row:focus-within::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row::before {
      transition: none;
    }
  }
</style>
